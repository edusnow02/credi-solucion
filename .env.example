# Ejemplo de configuración. NO poner valores reales acá: este archivo se sube a git.
# Para crear tu .env con claves nuevas:  cd backend && python crear_env.py

# 1 = modo desarrollo (muestra errores detallados). En producción: 0.
DEBUG=1

# Clave interna de Django (firma sesiones y CSRF). Larga y al azar.
SECRET_KEY=cambiar-por-una-clave-larga-al-azar

# Direcciones desde las que se puede entrar (separadas por coma).
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos. Vacía = SQLite local. Ejemplo PostgreSQL:
# DATABASE_URL=postgres://usuario:contrasena@localhost:5432/credisolucion
DATABASE_URL=

# Cifrado de datos personales (Fernet). Varias separadas por coma: la primera cifra, todas descifran.
# ¡Si se pierde esta clave, los datos cifrados no se pueden recuperar! Guardala fuera del repositorio.
CLAVES_CIFRADO=cambiar-por-una-clave-fernet

# Clave del índice ciego (búsqueda de CI sin descifrar). Distinta de la anterior.
CLAVE_INDICE=cambiar-por-otra-clave-al-azar

# Cola de tareas: cantidad de procesos que trabajan en paralelo. COLA_SINCRONA=1 corre todo sin worker.
COLA_TRABAJADORES=2
COLA_SINCRONA=0

# Onboarding (OCR). MOTOR_VISION=claude necesita ANTHROPIC_API_KEY y envía imágenes de documentos
# a un servicio externo: solo con consentimiento del cliente (Ley 7593/2025). Por defecto: nulo.
MOTOR_OCR=tesseract
MOTOR_VISION=nulo
UMBRAL_CONFIANZA=0.90
UMBRAL_ILEGIBLE=0.45
# ANTHROPIC_API_KEY=
